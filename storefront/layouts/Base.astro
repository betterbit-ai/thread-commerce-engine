---
interface Props {
  title: string;
  description?: string;
  disclosure?: string;
  showDisclosure?: boolean;
}
const {
  title,
  disclosure,
  showDisclosure = false,
  description = '일하는 사람의 책상·장비·업무도구 기록',
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/u, '');
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101512" />
    <link rel="icon" href={`${base}/favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={`${base}/`} aria-label="홈">
        <span class="brand-mark">✦</span><span>테크픽</span>
      </a>
    </header>
    <main><slot /></main>
    <footer>
      <strong>테크픽 | 일하는 사람의 도구</strong>
      <p>오래 앉아 일하는 사람의 책상·장비·업무도구 기록</p>
      {
        showDisclosure && disclosure ? (
          <p class="footer-disclosure">광고·제휴 안내: {disclosure}</p>
        ) : null
      }
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --ink: #18203a;
    --muted: #65708a;
    --paper: #f7f8fc;
    --card: #ffffff;
    --line: #dfe4f1;
    --accent: #5b8cff;
    --accent-dark: #345fc8;
    --warm: #f2b45e;
    font-family:
      Pretendard,
      Inter,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      sans-serif;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    line-height: 1.55;
  }
  a {
    color: inherit;
  }
  .site-header {
    max-width: 1120px;
    margin: auto;
    padding: 1rem 1.15rem;
  }
  .brand {
    display: inline-flex;
    gap: 0.65rem;
    align-items: center;
    text-decoration: none;
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .brand-mark {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    color: white;
    background: var(--accent-dark);
    border-radius: 50%;
  }
  main {
    min-height: 70vh;
  }
  footer {
    max-width: 1120px;
    margin: 4rem auto 0;
    padding: 2rem 1.15rem 3rem;
    color: var(--muted);
    border-top: 1px solid var(--line);
    font-size: 0.86rem;
  }
  footer p {
    margin: 0.45rem 0;
  }
  .shell {
    width: min(1120px, calc(100% - 2.3rem));
    margin: auto;
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.73rem;
    font-weight: 800;
    color: var(--accent-dark);
  }
  .button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    min-height: 3rem;
    padding: 0.65rem 1.05rem;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 800;
    background: var(--ink);
    color: white;
    border: 0;
  }
  .button:hover {
    background: var(--accent-dark);
  }
  .disclosure {
    padding: 1rem;
    border-left: 4px solid var(--warm);
    background: #fff8e7;
    font-size: 0.86rem;
  }
  .footer-disclosure {
    margin-top: 1rem;
  }
</style>
