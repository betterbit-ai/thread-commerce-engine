---
import Base from '../layouts/Base.astro';
import { storefrontData } from '../lib/offers';
const offers = storefrontData.offers;
const base = import.meta.env.BASE_URL.replace(/\/$/u, '');
const recommendedOffers = offers.filter((offer) => offer.recommended);
---

<Base title="테크픽 | 일하는 사람의 도구">
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow">TECHPICK DAILY</p>
      <h1>일하는 날을<br /><em>조금 덜 소모적으로.</em></h1>
      <p>오래 앉아 일하는 사람의 책상·장비·업무도구 기록입니다.</p>
      <a
        class="thread-link"
        href="https://www.threads.com/@techpick_daily"
        target="_blank"
        rel="noopener">Threads에서 기록 보기 ↗</a
      >
    </div>
    <aside class="principle-card">
      <span>테크픽의 기준</span>
      <strong>과장보다 확인된 정보,<br />장점만큼 단점도.</strong>
      <p>일상에서 오래 쓰는 도구를 더 잘 고르기 위한 생각을 남깁니다.</p>
    </aside>
  </section>

  <section class="shell notes">
    <div class="section-heading">
      <p class="eyebrow">DAILY NOTES</p>
      <h2>오늘의 기록</h2>
    </div>
    <div class="note-grid">
      <article>
        <span>01</span>
        <h3>일하는 날을 견디게 하는 작은 것들</h3>
        <p>책상 위 도구와 업무 환경을 조금씩 정돈하며 찾은 기준을 기록합니다.</p>
      </article>
      <article>
        <span>02</span>
        <h3>모두에게 맞는 장비는 없습니다</h3>
        <p>좋다는 말보다, 어떤 사람에게 맞고 맞지 않는지 먼저 살핍니다.</p>
      </article>
      <article>
        <span>03</span>
        <h3>추천은 충분히 검토한 뒤에</h3>
        <p>제휴 제품은 확인·검토·승인을 마친 경우에만 별도 페이지로 안내합니다.</p>
      </article>
    </div>
  </section>

  <section class="shell tools">
    <div class="section-heading row">
      <div><p class="eyebrow">RECOMMENDED TOOLS</p><h2>검토한 도구</h2></div>
      <span>{recommendedOffers.length}개 공개</span>
    </div>
    {
      recommendedOffers.length === 0 ? (
        <div class="empty">
          <strong>아직 공개한 추천 도구가 없습니다.</strong>
          <p>기록을 쌓은 뒤, 충분히 검토한 도구만 이곳에 소개합니다.</p>
        </div>
      ) : (
        <div class="grid">
          {recommendedOffers.map((offer) => (
            <article class="card">
              <span class="code">{offer.offer_code}번</span>
              <h3>{offer.product}</h3>
              <p>{offer.detail}</p>
              <a href={`${base}/offer/${offer.offer_code}/`}>검토 내용 보기 →</a>
            </article>
          ))}
        </div>
      )
    }
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.18fr 0.82fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
    padding: 6rem 0 5rem;
  }
  h1 {
    margin: 0.5rem 0 1.25rem;
    font-size: clamp(2.35rem, 6vw, 5rem);
    line-height: 1.02;
    letter-spacing: -0.065em;
  }
  h1 em {
    color: var(--accent-dark);
    font-style: normal;
  }
  .hero-copy > p {
    max-width: 42rem;
    color: var(--muted);
    font-size: 1.05rem;
  }
  .thread-link {
    display: inline-flex;
    margin-top: 1rem;
    color: var(--accent-dark);
    font-weight: 800;
    text-decoration: none;
  }
  .principle-card {
    padding: 2rem;
    border: 1px solid #cad6fb;
    border-radius: 24px;
    background: #eaf0ff;
  }
  .principle-card span,
  .note-grid span {
    color: var(--accent-dark);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.08em;
  }
  .principle-card strong {
    display: block;
    margin: 1rem 0;
    font-size: clamp(1.55rem, 3vw, 2.2rem);
    line-height: 1.22;
    letter-spacing: -0.05em;
  }
  .principle-card p {
    margin: 0;
    color: var(--muted);
  }
  .notes,
  .tools {
    padding: 4rem 0;
  }
  .notes {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .section-heading h2 {
    margin: 0.3rem 0 0;
    font-size: clamp(1.9rem, 4vw, 3rem);
    letter-spacing: -0.05em;
  }
  .note-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .note-grid article {
    padding: 1.35rem;
    border-radius: 18px;
    background: var(--card);
    border: 1px solid var(--line);
  }
  .note-grid h3 {
    margin: 1.5rem 0 0.5rem;
    font-size: 1.15rem;
    letter-spacing: -0.03em;
  }
  .note-grid p,
  .card p {
    color: var(--muted);
  }
  .row {
    display: flex;
    align-items: end;
    justify-content: space-between;
    margin: 2rem 0 1rem;
  }
  .row > span {
    color: var(--muted);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .card {
    min-width: 0;
    padding: 1.15rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 16px;
  }
  .card[hidden] {
    display: none;
  }
  .code {
    color: var(--accent-dark);
    font-weight: 900;
  }
  .card h3 {
    margin: 1.2rem 0 0.45rem;
    font-size: 1.3rem;
    letter-spacing: -0.03em;
  }
  .card a {
    font-weight: 800;
    color: var(--accent-dark);
  }
  .empty {
    padding: 3rem;
    text-align: center;
    border: 1px dashed var(--line);
    border-radius: 16px;
    color: var(--muted);
  }
  @media (max-width: 780px) {
    .hero {
      grid-template-columns: 1fr;
      padding: 3rem 0;
    }
    .grid {
      grid-template-columns: 1fr;
    }
    .note-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
