---
import Base from '../layouts/Base.astro';
import { storefrontData } from '../lib/offers';
const offers = storefrontData.offers;
const base = import.meta.env.BASE_URL.replace(/\/$/u, '');
const categories = [...new Set(offers.map((offer) => offer.category))];
const labels: Record<string, string> = {
  mouse: '마우스',
  keyboard: '키보드',
  desk: '데스크',
  productivity: '생산성 장비',
  apple_accessory: 'Apple 액세서리',
  apple_device: 'Apple 기기',
};
---

<Base title="오래 일하는 개발자의 장비" disclosure={storefrontData.disclosure}>
  <section class="hero shell">
    <div>
      <p class="eyebrow">WORKSTATION FIELD NOTES</p>
      <h1>장비에 돈 쓰기 전,<br /><em>오래 일하는 사람의 기준</em>부터.</h1>
      <p>
        하루 8–10시간 PC 앞에 있는 개발자를 위한 장비 기록입니다. 과장보다 확인된 정보, 장점만큼
        단점을 봅니다.
      </p>
    </div>
    <div class="finder">
      <label for="offer-code">Threads에서 본 번호</label>
      <div class="search-row">
        <input
          id="offer-code"
          inputmode="numeric"
          autocomplete="off"
          placeholder="예: 142"
        /><button id="search-button">바로 찾기</button>
      </div>
      <p id="search-status" aria-live="polite">번호만 입력하면 해당 제품이 바로 나타납니다.</p>
    </div>
  </section>

  <section class="shell content">
    <nav aria-label="제품 카테고리">
      <button class="chip active" data-category="all">전체</button>{
        categories.map((category) => (
          <button class="chip" data-category={category}>
            {labels[category] ?? category}
          </button>
        ))
      }
    </nav>
    <div class="section-title">
      <div><p class="eyebrow">RECENT OFFERS</p><h2>최근 검토한 장비</h2></div><span
        >{offers.length}개 기록</span
      >
    </div>
    {
      offers.length === 0 ? (
        <div class="empty">
          <>
            <strong>아직 공개된 오퍼가 없습니다.</strong>
            <p>캘리브레이션과 사람의 승인을 마친 캠페인만 표시됩니다.</p>
          </>
        </div>
      ) : (
        <div class="grid" id="offer-grid">
          {offers.map((offer) => (
            <article class="card" data-code={offer.offer_code} data-category={offer.category}>
              <div class="meta">
                <span class="code">{offer.offer_code}번</span>
                <span>{labels[offer.category] ?? offer.category}</span>
              </div>
              <h3>{offer.product}</h3>
              <p>{offer.detail}</p>
              <div class="price">
                {offer.price_krw === null
                  ? '가격 확인 필요'
                  : `${offer.price_krw.toLocaleString('ko-KR')}원`}
              </div>
              <small>
                {offer.captured_at
                  ? `${new Date(offer.captured_at).toLocaleString('ko-KR', { timeZone: 'Asia/Seoul' })} 캡처`
                  : '가격 캡처 없음'}
              </small>
              <a
                href={`${base}/offer/${offer.offer_code}/`}
                aria-label={`${offer.offer_code}번 상세 보기`}
              >
                정보 보기 →
              </a>
            </article>
          ))}
        </div>
      )
    }
  </section>
  <script define:vars={{ base }}>
    const input = document.querySelector('#offer-code');
    const status = document.querySelector('#search-status');
    const find = () => {
      const code = input.value.replace(/\D/g, '');
      const target = document.querySelector(`[data-code="${code}"]`);
      if (!code) {
        status.textContent = '번호를 입력해 주세요.';
        return;
      }
      if (target) window.location.href = `${base}/offer/${code}/`;
      else status.textContent = `${code}번 오퍼를 찾지 못했습니다. 번호를 다시 확인해 주세요.`;
    };
    document.querySelector('#search-button')?.addEventListener('click', find);
    input?.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') find();
    });
    document.querySelectorAll('[data-category]').forEach((button) =>
      button.addEventListener('click', () => {
        const category = button.dataset.category;
        document.querySelectorAll('.chip').forEach((chip) => chip.classList.remove('active'));
        button.classList.add('active');
        document.querySelectorAll('.card').forEach((card) => {
          card.hidden = category !== 'all' && card.dataset.category !== category;
        });
      }),
    );
  </script>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.18fr 0.82fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
    padding: 5rem 0 4rem;
  }
  h1 {
    margin: 0.5rem 0 1.25rem;
    font-size: clamp(2.35rem, 6vw, 5rem);
    line-height: 1.02;
    letter-spacing: -0.065em;
  }
  h1 em {
    color: var(--accent-dark);
    font-style: normal;
  }
  .hero > div > p:last-child {
    max-width: 42rem;
    color: var(--muted);
    font-size: 1.05rem;
  }
  .finder {
    background: var(--ink);
    color: white;
    padding: 1.35rem;
    border-radius: 20px;
    box-shadow: 0 22px 55px #10151222;
  }
  .finder label {
    display: block;
    margin-bottom: 0.65rem;
    font-weight: 800;
  }
  .search-row {
    display: flex;
    gap: 0.5rem;
  }
  .search-row input {
    width: 100%;
    min-width: 0;
    font: inherit;
    font-size: 1.25rem;
    padding: 0.75rem;
    border: 0;
    border-radius: 10px;
  }
  .search-row button {
    white-space: nowrap;
    font: inherit;
    font-weight: 800;
    color: var(--ink);
    background: var(--warm);
    border: 0;
    border-radius: 10px;
    padding: 0 1rem;
    cursor: pointer;
  }
  #search-status {
    min-height: 1.4rem;
    margin: 0.65rem 0 0;
    color: #bdc9c1;
    font-size: 0.82rem;
  }
  .content nav {
    display: flex;
    gap: 0.5rem;
    overflow: auto;
    padding-bottom: 0.75rem;
  }
  .chip {
    border: 1px solid var(--line);
    background: transparent;
    border-radius: 999px;
    padding: 0.55rem 0.9rem;
    white-space: nowrap;
    cursor: pointer;
  }
  .chip.active {
    background: var(--ink);
    color: white;
    border-color: var(--ink);
  }
  .section-title {
    display: flex;
    align-items: end;
    justify-content: space-between;
    margin: 2rem 0 1rem;
  }
  h2 {
    margin: 0.2rem 0;
    font-size: clamp(1.7rem, 4vw, 2.6rem);
    letter-spacing: -0.045em;
  }
  .section-title span {
    color: var(--muted);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .card {
    min-width: 0;
    padding: 1.15rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 16px;
  }
  .card[hidden] {
    display: none;
  }
  .meta {
    display: flex;
    justify-content: space-between;
    color: var(--muted);
    font-size: 0.8rem;
  }
  .code {
    color: var(--accent-dark);
    font-weight: 900;
  }
  .card h3 {
    margin: 1.2rem 0 0.45rem;
    font-size: 1.3rem;
    letter-spacing: -0.03em;
  }
  .card p {
    color: var(--muted);
    min-height: 3rem;
  }
  .price {
    margin-top: 1.2rem;
    font-weight: 900;
    font-size: 1.15rem;
  }
  .card small {
    display: block;
    color: var(--muted);
    margin: 0.2rem 0 1rem;
  }
  .card a {
    font-weight: 800;
    color: var(--accent-dark);
  }
  .empty {
    padding: 3rem;
    text-align: center;
    border: 1px dashed var(--line);
    border-radius: 16px;
    color: var(--muted);
  }
  @media (max-width: 780px) {
    .hero {
      grid-template-columns: 1fr;
      padding: 3rem 0;
    }
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
