---
import Base from '../layouts/Base.astro';
import { storefrontData } from '../lib/offers';
const offers = storefrontData.offers;
const base = import.meta.env.BASE_URL.replace(/\/$/u, '');
const recommendedOffers = offers.filter((offer) => offer.recommended);
const showToolSearch = recommendedOffers.length >= 3;
---

<Base title="테크픽 | 일하는 사람의 도구">
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow">TECHPICK DAILY</p>
      <h1>일하는 날을<br /><em>조금 덜 소모적으로.</em></h1>
      <p>오래 앉아 일하는 사람의 책상·장비·업무도구 기록입니다.</p>
      <a
        class="thread-link"
        href="https://www.threads.com/@techpick_daily"
        target="_blank"
        rel="noopener">Threads에서 기록 보기 ↗</a
      >
    </div>
    <aside class="principle-card">
      <span>테크픽의 기준</span>
      <strong>과장보다 확인된 정보,<br />장점만큼 단점도.</strong>
      <p>일상에서 오래 쓰는 도구를 더 잘 고르기 위한 생각을 남깁니다.</p>
    </aside>
  </section>

  <section class="shell notes">
    <div class="section-heading">
      <p class="eyebrow">OUR PRINCIPLES</p>
      <h2>테크픽의 기준</h2>
    </div>
    <div class="principles">
      <p>과장보다 확인된 정보</p>
      <p>장점만큼 단점도</p>
      <p>추천은 충분히 검토한 뒤에</p>
    </div>
  </section>

  <section class="shell tools">
    <div class="section-heading row">
      <div><p class="eyebrow">RECOMMENDED TOOLS</p><h2>검토한 도구</h2></div>
      <span>{recommendedOffers.length}개 공개</span>
    </div>
    {
      showToolSearch ? (
        <label class="tool-search">
          <span>검토한 도구 검색</span>
          <input id="tool-search" type="search" placeholder="도구 이름으로 검색" />
        </label>
      ) : null
    }
    {
      recommendedOffers.length === 0 ? (
        <div class="empty">
          <strong>아직 공개한 추천 도구가 없습니다.</strong>
          <p>기록을 쌓은 뒤, 충분히 검토한 도구만 이곳에 소개합니다.</p>
        </div>
      ) : (
        <div class="grid">
          {recommendedOffers.map((offer) => (
            <article
              class="card"
              data-tool-search={`${offer.product} ${offer.category}`.toLowerCase()}
            >
              <span class="code">{offer.offer_code}번</span>
              <h3>{offer.product}</h3>
              <p>{offer.detail}</p>
              <a href={`${base}/offer/${offer.offer_code}/`}>검토 내용 보기 →</a>
            </article>
          ))}
        </div>
      )
    }
  </section>
  <script>
    const input = document.querySelector('#tool-search');
    input?.addEventListener('input', () => {
      const query = input.value.trim().toLowerCase();
      document.querySelectorAll('[data-tool-search]').forEach((card) => {
        card.hidden = !card.dataset.toolSearch.includes(query);
      });
    });
  </script>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.18fr 0.82fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
    padding: 6rem 0 5rem;
  }
  h1 {
    margin: 0.5rem 0 1.25rem;
    font-size: clamp(2.35rem, 6vw, 5rem);
    line-height: 1.02;
    letter-spacing: -0.065em;
  }
  h1 em {
    color: var(--accent-dark);
    font-style: normal;
  }
  .hero-copy > p {
    max-width: 42rem;
    color: var(--muted);
    font-size: 1.05rem;
  }
  .thread-link {
    display: inline-flex;
    margin-top: 1rem;
    color: var(--accent-dark);
    font-weight: 800;
    text-decoration: none;
  }
  .principle-card {
    padding: 2rem;
    border: 1px solid #cad6fb;
    border-radius: 24px;
    background: #eaf0ff;
  }
  .principle-card span {
    color: var(--accent-dark);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.08em;
  }
  .principle-card strong {
    display: block;
    margin: 1rem 0;
    font-size: clamp(1.55rem, 3vw, 2.2rem);
    line-height: 1.22;
    letter-spacing: -0.05em;
  }
  .principle-card p {
    margin: 0;
    color: var(--muted);
  }
  .notes,
  .tools {
    padding: 4rem 0;
  }
  .notes {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .section-heading h2 {
    margin: 0.3rem 0 0;
    font-size: clamp(1.9rem, 4vw, 3rem);
    letter-spacing: -0.05em;
  }
  .principles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.5rem;
  }
  .principles p {
    margin: 0;
    padding: 0.7rem 0.95rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
  }
  .card p {
    color: var(--muted);
  }
  .row {
    display: flex;
    align-items: end;
    justify-content: space-between;
    margin: 2rem 0 1rem;
  }
  .row > span {
    color: var(--muted);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .card {
    min-width: 0;
    padding: 1.15rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 16px;
  }
  .card[hidden] {
    display: none;
  }
  .code {
    color: var(--accent-dark);
    font-weight: 900;
  }
  .card h3 {
    margin: 1.2rem 0 0.45rem;
    font-size: 1.3rem;
    letter-spacing: -0.03em;
  }
  .card a {
    font-weight: 800;
    color: var(--accent-dark);
  }
  .empty {
    padding: 3rem;
    text-align: center;
    border: 1px dashed var(--line);
    border-radius: 16px;
    color: var(--muted);
  }
  .tool-search {
    display: block;
    max-width: 28rem;
    margin: 1.5rem 0;
  }
  .tool-search span {
    display: block;
    margin-bottom: 0.45rem;
    font-size: 0.85rem;
    font-weight: 800;
  }
  .tool-search input {
    width: 100%;
    padding: 0.8rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--card);
    color: var(--ink);
    font: inherit;
  }
  @media (max-width: 780px) {
    .hero {
      grid-template-columns: 1fr;
      padding: 3rem 0;
    }
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
